<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Forsa">

        <!-- Phase 1 launcher: EmployeesActivity (Phase 2 switches launcher to MainActivity) -->
        <activity
            android:name=".ui.EmployeesActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AddEmployeeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.EditEmployeeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.EmployeeDetailsActivity"
            android:exported="false" />

    </application>

</manifest>
